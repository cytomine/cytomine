    "axios": "^1.18.0",
    "buefy": "^3.0.8",
    "bulma": "^1.0.4",
    "bulma-slider": "^2.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "copy-to-clipboard": "^3.0.8",
    "core-js": "^3.6.5",
    "detect-browser": "^4.7.0",
    "dom-to-image-more": "^3.10.2",
    "filesize": "^4.1.2",
    "ifvisible": "^1.1.0",
    "keycloak-js": "^24.0.4",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "npm-font-open-sans": "^1.1.0",
    "ol": "^5.3.1",
    "ol-rescale-feature": "^1.0.0",
    "ol-rotate-feature": "^2.0.1",
    "sl-vue-tree": "1.8.3",
    "v-click-outside-x": "^4.0.1",
    "v-tooltip": "^2.0.0-rc.33",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-color": "^2.7.0",
    "vue-draggable-resizable": "^2.2.0",
    "vue-i18n": "^11.4.8",
    "vue-multiselect": "^2.1.4",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^4.6.4",
    "vue-shortkey": "^3.1.6",
    "vue-slider-component": "^3.0.31",
    "vuelayers": "0.11.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
