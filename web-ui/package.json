    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "onchange": "^7.1.0",
    "randomstring": "^1.1.5",
    "sass": "^1.86.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
