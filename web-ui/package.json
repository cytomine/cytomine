{
  "name": "cytomine-web-ui",
  "description": "A web-based user interface for interacting with Cytomine.",
  "version": "4.0.0",
  "type": "module",
  "homepage": "https://uliege.cytomine.org/",
  "license": "Apache-2.0",
  "scripts": {
    "serve": "npm run watch-translations & vite",
    "build": "npm run translations-csv2json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "translations-csv2json": "node scripts/export_i18n_csv.js src/locales/translations.csv src/locales/json",
    "watch-translations": "onchange -i 'src/locales/translations.csv' -- npm run translations-csv2json"
  },
